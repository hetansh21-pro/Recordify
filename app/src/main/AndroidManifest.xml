<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for Video/Song streaming and Vidssave downloader -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android TV requirements: Leanback is supported, Touchscreen not required -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Foreground Service permissions for MediaProjection Playback Capture -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AudioVaultApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@null"
        android:fullBackupContent="@null"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AudioVault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appName}"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.AudioVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dedicated Android TV 10-Foot Leanback Launcher Activity -->
        <activity
            android:name=".ui.tv.TvMainActivity"
            android:exported="false"
            android:label="${appName}"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:theme="@style/Theme.AudioVault" />

        <!-- Foreground Service for audio capture -->
        <service
            android:name=".core.service.AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Service for audio playback task lifecycle & notification cleanup on recents removal -->
        <service
            android:name=".core.service.AudioPlaybackService"
            android:stopWithTask="true"
            android:exported="false" />

        <!-- Notification Listener Service for Intelligent Song Identification -->
        <service
            android:name=".core.intelligence.AudioVaultNotificationListener"
            android:label="AudioVault Song Identifier"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Receiver for interactive notification playback controls -->
        <receiver
            android:name=".core.service.PlaybackActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.audiovault.app.ACTION_PLAY_PAUSE" />
                <action android:name="com.audiovault.app.ACTION_NEXT" />
                <action android:name="com.audiovault.app.ACTION_PREV" />
                <action android:name="com.audiovault.app.ACTION_CLOSE_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Receiver for Bluetooth Earbuds & Headset Hardware Media Buttons -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for secure recording sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
